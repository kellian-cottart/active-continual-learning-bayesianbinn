{
  "network": "binarybayesianconvcifar100",
  "network_params": {
    "layers": [1024, 10],
    "temperature": 1,
    "activation_fn": "sign"
  },
  "optimizer": "bimu",
  "optimizer_params": {
    "likelihood_multiplier": {
      "type": "float",
      "step": 1,
      "low": 10,
      "high": 1000
    },
    "kl_multiplier": {
      "type": "float",
      "step": 1,
      "low": 0.1,
      "high": 20
    },
    "lr_max": {
      "type": "float",
      "step": 1,
      "low": 0.0001,
      "high": 0.1
    },
    "N": {
      "type": "int",
      "step": 50,
      "low": 100,
      "high": 20000
    },
    "lr": {
      "type": "float",
      "step": 1,
      "low": 0.1,
      "high": 100
    }
  },
  "task": "cifar10",
  "task_params": {
    "dataset_normalisation": "standardised"
  },
  "n_tasks": 1,
  "epochs": 40,
  "seed": 1000,
  "n_train_samples": 1,
  "n_test_samples": 1,
  "train_batch_size": 64,
  "test_batch_size": 512
}
