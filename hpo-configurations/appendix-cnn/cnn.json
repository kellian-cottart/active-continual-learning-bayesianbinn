{
  "network": "realconvcifar100",
  "network_params": {
    "layers": [1024, 1024, 10],
    "activation_fn": "relu"
  },
  "optimizer": "adam",
  "optimizer_params": {
    "learning_rate": {
      "type": "float",
      "step": 1,
      "low": 1e-6,
      "high": 1e-3
    }
  },
  "task": "cifar10",
  "task_params": {
    "dataset_normalisation": "standardised",
    "data_augmentation": true,
    "validation": true
  },
  "n_tasks": 1,
  "epochs": 100,
  "seed": 1000,
  "train_batch_size": 32,
  "test_batch_size": 512
}
