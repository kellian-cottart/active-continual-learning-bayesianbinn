{
  "network": "binarymlpbatchnorm",
  "network_params": {
    "layers": [784, 100, 10],
    "activation_fn": "reversebinarygate",
    "activation_params": {
      "width": 1
    }
  },
  "optimizer": "synapticmetaplasticity",
  "optimizer_params": {
    "lr": 5.7e-5,
    "metaplasticity": 8.7,
    "weight_decay": 7.8e-6
  },
  "task": "permutedmnist",
  "task_params": {
    "dataset_normalisation": "standardised"
  },
  "n_tasks": 100,
  "epochs": 1,
  "train_batch_size": 1,
  "test_batch_size": 200,
  "seed": 0,
  "max_parallel_permutation": 25
}
