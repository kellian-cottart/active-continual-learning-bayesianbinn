{
  "network": "binarybayesianmlp",
  "network_params": {
    "layers": [784, 100, 10],
    "temperature": 1,
    "activation_fn": "sign",
    "activation_params": {
      "offset": 0
    }
  },
  "optimizer": "bimu",
  "optimizer_params": {
    "likelihood_multiplier": 991,
    "kl_multiplier": 3.6,
    "lr_max": 0.004,
    "N": 2000,
    "lr": 0.6
  },
  "task": "permutedmnist",
  "task_params": {
    "dataset_normalisation": "standardised"
  },
  "n_tasks": 100,
  "epochs": 1,
  "train_batch_size": 1,
  "test_batch_size": 200,
  "seed": 0,
  "n_train_samples": 5,
  "n_test_samples": 5,
  "max_parallel_permutation": 25
}
