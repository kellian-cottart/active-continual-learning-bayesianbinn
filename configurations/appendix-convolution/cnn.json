{
  "network": "realconvcifar100",
  "network_params": {
    "layers": [1024, 1024, 10],
    "activation_fn": "relu"
  },
  "optimizer": "adam",
  "optimizer_params": {
    "learning_rate": 1e-4
  },
  "task": "cifar10",
  "task_params": {
    "dataset_normalisation": "standardised",
    "data_augmentation": true
  },
  "n_tasks": 1,
  "epochs": 500,
  "seed": 1000,
  "train_batch_size": 128,
  "test_batch_size": 512,
  "n_splits_per_epoch": 1
}
