{
  "network": "binarybayesianconvcifar100",
  "network_params": {
    "layers": [1024, 10],
    "temperature": 1,
    "activation_fn": "sign"
  },
  "optimizer": "bimu",
  "optimizer_params": {
    "likelihood_multiplier": 70,
    "kl_multiplier": 1,
    "lr_max": 0.08,
    "N": 20000,
    "lr": 33
  },
  "task": "cifar10",
  "task_params": {
    "dataset_normalisation": "standardised",
    "data_augmentation": true
  },
  "n_tasks": 1,
  "epochs": 100,
  "seed": 1000,
  "n_train_samples": 1,
  "n_test_samples": 1,
  "train_batch_size": 64,
  "test_batch_size": 512,
  "n_splits_per_epoch": 1
}
