{
  "network": "binarybayesianconvmnist",
  "network_params": {
    "layers": [1024, 10],
    "temperature": 1,
    "activation_fn": "reversegate",
    "activation_params": {
      "width": 1
    }
  },
  "optimizer": "bimu",
  "optimizer_params": {
    "likelihood_multiplier": 50,
    "kl_multiplier": 0.3,
    "lr_max": 0.08,
    "N": 1000,
    "lr": 10
  },
  "task": "fashion",
  "task_params": {
    "dataset_normalisation": "standardised"
  },
  "n_tasks": 1,
  "epochs": 100,
  "seed": 1000,
  "n_train_samples": 5,
  "n_test_samples": 5,
  "train_batch_size": 64,
  "test_batch_size": 512,
  "n_splits_per_epoch": 1
}
