{
  "network": "binarybayesianconvmnist",
  "network_params": {
    "layers": [1024, 10],
    "temperature": 1,
    "activation_fn": "reversegate",
    "activation_params": {
      "width": 1
    },
    "active_learning": {
      "mode": 6,
      "samples": 10,
      "budget": 0.1,
      "scaler": 0.5
    }
  },
  "optimizer": "bimu",
  "optimizer_params": {
    "likelihood_multiplier": 250,
    "kl_multiplier": 1,
    "lr_max": 0.08,
    "N": 10000,
    "lr": 30
  },
  "task": "mnist",
  "task_params": {
    "dataset_normalisation": "standardised"
  },
  "n_tasks": 1,
  "epochs": 1,
  "seed": 1000,
  "n_train_samples": 1,
  "n_test_samples": 1,
  "train_batch_size": 1,
  "test_batch_size": 512,
  "n_splits_per_epoch": 20
}
