{
  "network": "mlp",
  "network_params": {
    "layers": [1024, 18],
    "activation_fn": "relu"
  },
  "si": {
    "coefficient": 0.003,
    "damping_factor": 0.13
  },
  "optimizer": "sgd",
  "optimizer_params": {
    "lr": 0.006
  },
  "task": "openloris",
  "task_params": {
    "subfeatures": 1024,
    "dataset_normalisation": "none",
    "feature_extraction": true,
    "feature_extractor": "vgg19",
    "classes": [
      "bottle",
      "bowl",
      "corkscrew",
      "cottonswab",
      "pencil",
      "cushion",
      "glasses",
      "ladle",
      "mask",
      "knife",
      "paper_cutter",
      "cup",
      "plug",
      "pot",
      "scissors",
      "stapler",
      "thermometer",
      "plasticbag"
    ],
    "ood_classes": ["toy"]
  },
  "n_tasks": 12,
  "epochs": 1,
  "seed": 1000,
  "train_batch_size": 1,
  "test_batch_size": 4
}
