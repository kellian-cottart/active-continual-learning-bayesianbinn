{
  "network": "binarymlp",
  "network_params": {
    "layers": [8192, 18],
    "activation_fn": "sign"
  },
  "optimizer": "adam",
  "optimizer_params": {
    "learning_rate": 0.003
  },
  "task": "openloris",
  "task_params": {
    "subfeatures": 8192,
    "dataset_normalisation": "none",
    "feature_extraction": true,
    "feature_extractor": "vgg19",
    "classes": [
      "bottle",
      "bowl",
      "corkscrew",
      "cottonswab",
      "pencil",
      "cushion",
      "glasses",
      "ladle",
      "mask",
      "knife",
      "paper_cutter",
      "cup",
      "plug",
      "pot",
      "scissors",
      "stapler",
      "thermometer",
      "plasticbag"
    ],
    "ood_classes": ["toy"]
  },
  "n_tasks": 12,
  "epochs": 1,
  "seed": 1000,
  "train_batch_size": 1,
  "test_batch_size": 4
}
