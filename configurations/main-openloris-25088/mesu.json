{
  "network": "bayesianmlp",
  "network_params": {
    "layers": [25088, 18],
    "activation_fn": "relu"
  },
  "optimizer": "mesu",
  "optimizer_params": {
    "lr_mu": 71.91,
    "lr_sigma": 0.015,
    "sigma_prior": 0.69,
    "N": 449000,
    "clamp_grad": 0.61
  },
  "task": "openloris",
  "task_params": {
    "dataset_normalisation": "none",
    "feature_extraction": true,
    "feature_extractor": "vgg19",
    "classes": [
      "bottle",
      "bowl",
      "corkscrew",
      "cottonswab",
      "pencil",
      "cushion",
      "glasses",
      "ladle",
      "mask",
      "knife",
      "paper_cutter",
      "cup",
      "plug",
      "pot",
      "scissors",
      "stapler",
      "thermometer",
      "plasticbag"
    ],
    "ood_classes": ["toy"]
  },
  "n_tasks": 12,
  "epochs": 1,
  "seed": 1000,
  "n_train_samples": 10,
  "n_test_samples": 10,
  "train_batch_size": 1,
  "test_batch_size": 4
}
