{
  "network": "binarymlp",
  "network_params": {
    "layers": [25088, 18],
    "activation_fn": "sign",
    "activation_params": {
      "offset": 0
    }
  },
  "optimizer": "synapticmetaplasticity",
  "optimizer_params": {
    "lr": 0.0003,
    "metaplasticity": 5.6,
    "weight_decay": 3.3e-12
  },
  "task": "openloris",
  "task_params": {
    "dataset_normalisation": "none",
    "feature_extraction": true,
    "feature_extractor": "vgg19",
    "classes": [
      "bottle",
      "bowl",
      "corkscrew",
      "cottonswab",
      "pencil",
      "cushion",
      "glasses",
      "ladle",
      "mask",
      "knife",
      "paper_cutter",
      "cup",
      "plug",
      "pot",
      "scissors",
      "stapler",
      "thermometer",
      "plasticbag"
    ],
    "ood_classes": ["toy"]
  },
  "n_tasks": 12,
  "epochs": 1,
  "seed": 1000,
  "train_batch_size": 1,
  "test_batch_size": 4
}
