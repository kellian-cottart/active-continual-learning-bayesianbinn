{
  "network": "mlp",
  "network_params": {
    "layers": [784, 100, 10],
    "activation_fn": "relu"
  },
  "optimizer": "sgd",
  "optimizer_params": {
    "lr": 0.003
  },
  "task": "permutedmnist",
  "task_params": {
    "dataset_normalisation": "standardised"
  },
  "n_tasks": 1000,
  "epochs": 1,
  "train_batch_size": 1,
  "test_batch_size": 500,
  "max_parallel_permutation": 10,
  "seed": 1000,
  "si": {
    "coefficient": 1e-4,
    "damping_factor": 1
  }
}
