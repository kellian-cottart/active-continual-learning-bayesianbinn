{
  "network": "binarymlp",
  "network_params": {
    "layers": [784, 100, 10],
    "activation_fn": "sign"
  },
  "optimizer": "adam",
  "optimizer_params": {
    "learning_rate": 0.0001,
    "weight_decay": 2.2e-9
  },
  "task": "permutedmnist",
  "task_params": {
    "dataset_normalisation": "standardised"
  },
  "n_tasks": 1000,
  "epochs": 1,
  "train_batch_size": 1,
  "test_batch_size": 500,
  "max_parallel_permutation": 100,
  "seed": 0
}
