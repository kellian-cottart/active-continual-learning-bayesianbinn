{
  "network": "mlp",
  "network_params": {
    "layers": [784, 100, 10],
    "activation_fn": "relu"
  },
  "optimizer": "sgd",
  "optimizer_params": {
    "lr": 0.003
  },
  "task": "permutedmnist",
  "task_params": {
