  },
  "n_tasks": 1000,
  "epochs": 1,
  "train_batch_size": 1,
  "test_batch_size": 500,
  "max_parallel_permutation": 10,
  "seed": 1000,
  "online-ewc": {
    "importance": 4.1,
    "downweighting": 0.7
  }
}
