{
  "network": "binarymlpbatchnorm",
  "network_params": {
    "layers": [784, 100, 10],
    "activation_fn": "sign",
    "activation_params": {
      "offset": 0
    }
  },
  "optimizer": "synapticmetaplasticity",
  "optimizer_params": {
    "lr": 3.7e-5,
    "metaplasticity": 7.2,
    "weight_decay": 2.9e-9
  },
  "task": "permutedmnist",
  "task_params": {
    "dataset_normalisation": "standardised"
  },
  "n_tasks": 1000,
  "epochs": 1,
  "train_batch_size": 1,
  "test_batch_size": 100,
  "seed": 0,
  "max_parallel_permutation": 10
}
