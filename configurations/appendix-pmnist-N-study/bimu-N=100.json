{
  "network": "binarybayesianmlp",
  "network_params": {
    "layers": [784, 100, 10],
    "temperature": 1,
    "activation_fn": "reversebinarygate"
  },
  "optimizer": "bimu",
  "optimizer_params": {
    "lr_max": 0.005,
    "likelihood_multiplier": 64,
    "N": 100,
    "lr": 7.5
  },
  "task": "permutedmnist",
  "n_tasks": 100,
  "epochs": 1,
  "max_parallel_permutation": 100,
  "train_batch_size": 1,
  "test_batch_size": 500,
  "seed": 0,
  "n_train_samples": 5,
  "n_test_samples": 5
}
