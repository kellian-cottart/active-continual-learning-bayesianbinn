{
  "network": "bayesianmlp",
  "network_params": {
    "layers": [784, 2000, 10],
    "activation_fn": "relu"
  },
  "optimizer": "mesu",
  "optimizer_params": {
    "lr_mu": 2.2,
    "lr_sigma": 0.47,
    "mu_prior": 0,
    "sigma_prior": 0.46,
    "N": 1600000,
    "clamp_grad": 0.83
  },
  "task": "permutedmnist",
  "task_params": {
    "dataset_normalisation": "standardised"
  },
  "n_train_samples": 10,
  "n_test_samples": 10,
  "n_tasks": 1000,
  "epochs": 1,
  "train_batch_size": 1,
  "test_batch_size": 100,
  "seed": 1000,
  "max_parallel_permutation": 100
}
