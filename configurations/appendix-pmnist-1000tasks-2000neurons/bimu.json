{
  "network": "binarybayesianmlp",
  "network_params": {
    "layers": [784, 2000, 10],
    "temperature": 1,
    "activation_fn": "reversebinarygate"
  },
  "optimizer": "bimu",
  "optimizer_params": {
    "likelihood_multiplier": 280.7,
    "kl_multiplier": 6.2,
    "lr_max": 0.005,
    "N": 1000,
    "lr": 60
  },
  "task": "permutedmnist",
  "task_params": {
    "dataset_normalisation": "standardised"
  },
  "n_tasks": 1000,
  "epochs": 1,
  "seed": 0,
  "n_train_samples": 5,
  "n_test_samples": 5,
  "train_batch_size": 1,
  "test_batch_size": 100,
  "max_parallel_permutation": 25
}
