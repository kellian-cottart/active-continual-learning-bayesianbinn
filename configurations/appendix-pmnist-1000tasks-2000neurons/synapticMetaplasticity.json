{
  "network": "binarymlpbatchnorm",
  "network_params": {
    "layers": [784, 2000, 10],
    "activation_fn": "sign",
    "activation_params": {
      "offset": 0
    }
  },
  "optimizer": "synapticmetaplasticity",
  "optimizer_params": {
    "lr": 1e-5,
    "metaplasticity": 6.3,
    "weight_decay": 1.46e-6
  },
  "task": "permutedmnist",
  "task_params": {
    "dataset_normalisation": "standardised"
  },
  "n_tasks": 1000,
  "epochs": 1,
  "train_batch_size": 1,
  "test_batch_size": 100,
  "max_parallel_permutation": 25,
  "seed": 1000
}
