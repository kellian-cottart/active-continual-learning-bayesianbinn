{
  "network": "mlp",
  "network_params": {
    "layers": [8192, 18],
    "activation_fn": "relu"
  },
  "si": {
    "coefficient": 4.5e-5,
    "damping_factor": 0.05
  },
  "optimizer": "sgd",
  "optimizer_params": {
    "lr": 0.0004
  },
  "task": "openloris",
  "task_params": {
    "subfeatures": 8192,
    "dataset_normalisation": "standardised",
    "feature_extraction": true,
    "feature_extractor": "vgg19",
    "classes": [
      "bottle",
      "bowl",
      "corkscrew",
      "cottonswab",
      "pencil",
      "cushion",
      "glasses",
      "ladle",
      "mask",
      "knife",
      "paper_cutter",
      "cup",
      "plug",
      "pot",
      "scissors",
      "stapler",
      "thermometer",
      "plasticbag"
    ],
    "ood_classes": ["toy"]
  },
  "n_tasks": 12,
  "epochs": 1,
  "seed": 0,
  "train_batch_size": 1,
  "test_batch_size": 128
}
